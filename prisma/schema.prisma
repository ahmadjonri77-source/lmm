generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  SUPERADMIN
  TEACHER
  ASISTENT
  STUDENT
}

enum CourseLevel {
  BEGINNER
  ELEMENTERIY
  PREINTERMEDIA
  INTERMEDIATE
  ADVANCED
}

enum Answer {
  variantA
  variantB
  variantC
  variantD
}

enum Status {
  ACTIVE
  INACTIVE
  FREEZE
}

model User {
  id        Int      @id @default(autoincrement())
  full_name String
  phone     String   @unique
  password  String
  email     String?
  file      String?
  role      UserRole
  create_at DateTime @default(now())
  update_at DateTime @updatedAt
  status    Status   @default(ACTIVE)

  courses       Courses[]
  mentorCourses Courses[] @relation("CourseMentor")

  mentorProfiles  MentorProfile?
  assignedCourses AssignedCourse[]

  @@map("users")
}

model MentorProfile {
  id          Int      @id @default(autoincrement())
  userId      Int      @unique
  experience  Float?
  job         String?
  web_link    String?
  description String?
  facebook    String?
  telegram    String?
  linkedin    String?
  instagram   String?
  github      String?
  create_at   DateTime @default(now())
  update_at   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("mentor_profile")
}

model AssignedCourse {
  id        Int       @id @default(autoincrement())
  userId    Int
  coursesId Int
  user      User    @relation(references: [id], fields: [userId], onDelete: Cascade)
  course    Courses @relation(references: [id], fields: [coursesId], onDelete: Cascade)
  status    Status  @default(INACTIVE)

  create_at DateTime @default(now())
  update_at DateTime @updatedAt

}

model Categories {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  create_at DateTime  @default(now())
  update_at DateTime  @updatedAt
  courses   Courses[]

  @@map("categories")
}

model Courses {
  id Int @id @default(autoincrement())

  assistantId Int?
  mentorId    Int
  name        String      @unique
  banner      String
  intro_video String
  description String
  price       Decimal
  categoryId  Int
  status      Status      @default(ACTIVE)
  level       CourseLevel

  create_at DateTime @default(now())
  update_at DateTime @updatedAt

  user            User?            @relation(fields: [assistantId], references: [id], onDelete: Cascade)
  mentor          User             @relation("CourseMentor", fields: [mentorId], references: [id], onDelete: Cascade)
  sections        Sections[]
  categories      Categories?      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  assignedCourses AssignedCourse[]

  @@map("courses")
}

model Sections {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  courseId  Int
  create_at DateTime  @default(now())
  update_at DateTime  @updatedAt
  lessons   Lessons[]
  courses   Courses   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@map("sections")
}

model Lessons {
  id          Int         @id @default(autoincrement())
  name        String      @unique
  sectionId   Int
  description String
  file        String
  create_at   DateTime    @default(now())
  update_at   DateTime    @updatedAt
  exams       Exam[]
  homeworks   Homeworks[]
  section     Sections    @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  materials   Materials[]

  @@map("lessons")
}

model Materials {
  id            Int            @id @default(autoincrement())
  lessonId      Int
  description   String
  file          String
  create_at     DateTime       @default(now())
  update_at     DateTime       @updatedAt
  materialFiles MaterialFile[]
  lessons       Lessons        @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@map("materials")
}

model MaterialFile {
  id         Int       @id @default(autoincrement())
  materialId Int
  file       String
  materials  Materials @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@map("material_files")
}

model Homeworks {
  id          Int      @id @default(autoincrement())
  lessonId    Int
  description String
  file        String?
  create_at   DateTime @default(now())
  update_at   DateTime @updatedAt
  lessons     Lessons  @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@map("homeworks")
}

model Exam {
  id        Int      @id @default(autoincrement())
  lessonId  Int
  question  String
  variantA  String
  variantB  String
  variantC  String
  variantD  String
  answer    Answer
  create_at DateTime @default(now())
  update_at DateTime @updatedAt
  lessons   Lessons  @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@map("exam")
}
